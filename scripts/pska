#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$ROOT/.pska/venvs/pska-py312"

if [[ ! -x "$VENV/bin/python" ]]; then
  echo "PSKA Python 3.12 venv not found at $VENV" >&2
  echo "Create it with: ./scripts/bootstrap_pska_env" >&2
  exit 1
fi

if [[ -z "${SSL_CERT_FILE:-}" ]]; then
  CERT_FILE="$("$VENV/bin/python" -c 'import certifi; print(certifi.where())' 2>/dev/null || true)"
  if [[ -n "$CERT_FILE" && -f "$CERT_FILE" ]]; then
    export SSL_CERT_FILE="$CERT_FILE"
  fi
fi

export PYTHONPATH="$ROOT/core/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$VENV/bin/python" -m pska_core.cli "$@"
