#!/usr/bin/env python3
"""Write a local FastReAct config that binds PSKA through MCP."""

from __future__ import annotations

import argparse
import json
import subprocess
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
DEFAULT_OUTPUT = Path.home() / ".fastreact" / "config.json"
DEFAULT_KEY_FILE = Path.home() / "api_key.txt"
DEFAULT_PSKA_PYTHON = ROOT / ".pska" / "venvs" / "pska-py312" / "bin" / "python"
DEFAULT_FASTREACT_PORT = 18741


def certifi_path(python: Path) -> str | None:
    if not python.exists():
        return None
    try:
        result = subprocess.run(
            [str(python), "-c", "import certifi; print(certifi.where())"],
            check=True,
            capture_output=True,
            text=True,
        )
    except (subprocess.CalledProcessError, OSError):
        return None
    value = result.stdout.strip()
    return value or None


def build_config(args: argparse.Namespace) -> dict:
    env = {}
    ssl_cert_file = certifi_path(args.pska_python)
    if ssl_cert_file:
        env["SSL_CERT_FILE"] = ssl_cert_file

    mcp_server = {
        "name": "pska",
        "isolation": "shared",
        "description": "PSKA personal knowledge store tools.",
    }
    if args.mcp_transport == "http":
        mcp_server.update(
            {
                "transport": "http",
                "url": args.pska_http_url,
                "identity_forwarding": {
                    "mode": "identity_params",
                    "audience": "pska",
                },
            }
        )
        if args.mcp_auth_token_ref:
            mcp_server["auth_token_ref"] = args.mcp_auth_token_ref
    else:
        mcp_server.update(
            {
                "transport": "stdio",
                "command": str(ROOT / "scripts" / "pska"),
                "args": ["--config", str(args.pska_config), "mcp-server"],
                "env": env,
                "identity_forwarding": {
                    "mode": "identity_params",
                    "audience": "pska",
                    "stdio_dev_only": True,
                },
            }
        )

    return {
        "llm": {
            "api_key_file": str(args.api_key_file),
        },
        "service": {
            "host": args.host,
            "port": args.port,
            "log_level": args.log_level,
        },
        "mcp": {
            "servers": [mcp_server]
        },
        "policy": {
            "default_action": "deny",
            "tool_rules": {
                "exec": "deny",
                "read_file": "deny",
                "write_file": "deny",
                "edit_file": "deny",
                "pska_pska_search": "allow",
                "pska_pska_index_status": "allow",
                "pska_pska_read_evidence_context": "allow",
                "pska_pska_graph_context": "allow",
                "pska_pska_digest_context": "allow",
                "pska_pska_job_context": "allow",
                "pska_pska_write_candidates": "allow",
                "pska_pska_ingest_channel_payload": "deny",
                "pska_pska_extract_all": "deny",
                "pska_pska_review_items": "deny",
            },
            "tool_profiles": {
                "pska_ask_read": {
                    "description": "Read-only PSKA research tools for Ask deep mode.",
                    "tools": [
                        "pska_pska_search",
                        "pska_pska_index_status",
                        "pska_pska_read_evidence_context",
                        "pska_pska_graph_context",
                        "pska_pska_digest_context",
                    ],
                },
                "pska_digest_worker": {
                    "description": "PSKA digest worker tools for job-scoped candidate writing.",
                    "tools": [
                        "pska_pska_job_context",
                        "pska_pska_write_candidates",
                    ],
                },
                "coding_workspace": {
                    "description": "Native coding tools; require a coding-agent profile and workspace path guard.",
                    "tools": ["read_file", "write_file", "edit_file", "exec"],
                },
            },
        },
    }


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--api-key-file", type=Path, default=DEFAULT_KEY_FILE)
    parser.add_argument("--pska-python", type=Path, default=DEFAULT_PSKA_PYTHON)
    parser.add_argument("--pska-config", type=Path, default=ROOT / ".pska" / "config.json")
    parser.add_argument("--database-url", default="postgresql:///pska", help=argparse.SUPPRESS)
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=DEFAULT_FASTREACT_PORT)
    parser.add_argument("--log-level", default="info")
    parser.add_argument("--mcp-transport", choices=["stdio", "http"], default="stdio")
    parser.add_argument("--pska-http-url", default="http://127.0.0.1:8765/mcp")
    parser.add_argument("--mcp-auth-token-ref", default="mcp_api_keys.pska")
    parser.add_argument("--print", action="store_true", help="Print config instead of writing it")
    args = parser.parse_args()

    config = build_config(args)
    if args.print:
        print(json.dumps(config, ensure_ascii=False, indent=2))
        return

    args.output.expanduser().parent.mkdir(parents=True, exist_ok=True)
    args.output.expanduser().write_text(json.dumps(config, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(args.output.expanduser())


if __name__ == "__main__":
    main()
