{
  "_comment": "PSKA local online service preset. Copy to ~/.pska/config.json or .pska/config.json.",
  "database": {
    "url": "postgresql:///pska"
  },
  "workspace": {
    "root": "~/PSKA_workspaces"
  },
  "startup": {
    "bootstrap": true,
    "backend": true,
    "frontend": {
      "enabled": true,
      "mode": "gateway",
      "host": "0.0.0.0",
      "port": 5173
    }
  },
  "service": {
    "host": "0.0.0.0",
    "port": 8765,
    "service_token": null
  },
  "llm": {
    "api_key_file": "~/api_key.txt",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "timeout_seconds": 60
  },
  "fastreact": {
    "url": "http://127.0.0.1:18741",
    "service_token": null,
    "timeout_seconds": 30,
    "model": "deepseek-v4-flash",
    "temperature": 0.3,
    "top_p": 0.9,
    "max_tokens": 4096
  },
  "embedding": {
    "provider": "disabled",
    "model": "BAAI/bge-m3",
    "dimensions": 1024,
    "batch_size": 16,
    "api_key_file": null,
    "base_url": "https://api.openai.com/v1",
    "timeout_seconds": 60
  },
  "ingest": {
    "chunk_size": 1200,
    "chunk_overlap": 0
  },
  "files": {
    "roots": [],
    "ignore": [
      "*.tmp",
      "*.bak"
    ],
    "max_bytes": 52428800,
    "spreadsheet_max_rows_per_sheet": 2000,
    "spreadsheet_max_columns": 80,
    "tenant_id": "tenant_default",
    "owner_user_id": "user_primary",
    "space_id": "private_primary",
    "visibility": "private"
  },
  "document_parser": {
    "enabled": false,
    "url": "http://127.0.0.1:8083/rag/model_parser_file",
    "timeout_seconds": 120,
    "extract_image": false,
    "extract_image_content": false,
    "return_json": false,
    "extensions": [
      ".pdf",
      ".png",
      ".jpg",
      ".jpeg",
      ".webp",
      ".gif"
    ]
  }
}
